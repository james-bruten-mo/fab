from pathlib import Path
from typing import Iterable

from fab.api.v3 import (
    BuildScript,
    Project,
    GitRepository,
    Repository
)

class Skeleton(BuildScript):
    def repositories(self, dependencies_file: Path) -> Iterable[Repository]:
        return [
            GitRepository(
                identity="lfric_core",
                source="git@github.com:MetOffice/lfric_core.git",
                ref="vn3.1",
                paths={"psyclone_config": Path("etc/psyclone.cfg")},
                projects=[
                    Project(
                        Path("infrastructure"),
                        paths={
                            "generate-config-loader": Path(
                                "build/tools/GenerateConfigLoader"
                            ),
                            "generate-config-type": Path(
                                "build/tools/GenerateConfigType"
                            ),
                            "generate-extended-namelist-type": Path(
                                "build/tools/GenerateExtendedNamelistType"
                            ),
                            "generate-feigns": Path("build/tools/GenerateFeigns"),
                            "generate-namelist-loader": Path(
                                "build/tools/GenerateNamelistLoader"
                            ),
                            "templaterator": Path("build/tools/Templaterator"),
                        },
                    ),
                    Project(
                        Path("components/driver"),
                        #
                        # Any tests which use "feigners" needs the "NO_MPI"
                        # macro set, which conflicts with our need to not set
                        # it.
                        #
                        unit_test_dir=Path("no_tests"),
                    ),
                    Project(
                        Path("components/science"),
                        #
                        # Any tests which use "feigners" needs the "NO_MPI"
                        # macro set, which conflicts with our need to not set
                        # it.
                        #
                        unit_test_dir=Path("no_tests"),
                    ),
                    Project(Path("components/inventory")),
                    Project(Path("components/lfric-xios")),
                    Project(
                        Path("applications/skeleton"),
                        configuration_meta_data=Path(
                            "rose-meta/lfric-skeleton/HEAD/rose-meta.conf"
                        ),
                    ),
                ],
            )
        ]

    def packages(self) -> Iterable[str]:
        package_list = ["yaxt", "yaxt_c", "netcdf-fortran", "netcdf", "xios"]

        # Todo: How to switch pFUnit on and off depending on whether we're
        #       using it?
        #
        package_list.extend(["pfunit", "funit", "fargparse", "gftl", "gftl-shared"])

        return package_list

    def fpp_definitions(self) -> dict:
        return {
            "LFRIC": "true",
            "USSPREC_32B": "true",
            "LSPREC_32B": "true",
            # I/O platform
            "USE_XIOS": "true",
            # Component precision
            "RDEF_PRECISION": "64",
            "R_SOLVER_PRECISION": "32",
            "R_TRAN_PRECISION": "64",
            "R_BL_PRECISION": "64",
            # Transitional
            "LEGACY_MPI": "true",
        }

    def openmp(self) -> bool:
        return True

    def fortran_pp_flags(self) -> list[str]:
        return ["-traditional-cpp", "-P"]

    _COMMON_FORTRAN = [
        "-std=f2008",
        "-ffree-line-length-none",
    ]

    def fortran_compile_flags_common(self) -> list[str]:
        return self._COMMON_FORTRAN

    def fortran_overrides(self) -> dict:
        return {
            Path("infrastructure/utilities/lfric_mpi_mod.f90"): {
                "compile_flags": self._COMMON_FORTRAN + ["-fallow-argument-mismatch"],
            },
            Path("infrastructure/utilities/timer_mod_test.f90"): {
                "compile_flags": self._COMMON_FORTRAN + ["-fall-instrinsics"]
            },
        }
