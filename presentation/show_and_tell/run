#!/bin/sh

if [ -d venv ]; then
    source venv/bin/activate
    pip uninstall ToyBuildSystem
else
    python3.12 -m venv venv
    source venv/bin/activate
    pip install --upgrade pip
    pip install jupyter bash_kernel
    python -m bash_kernel.install
fi

rm -rf working
jupyter-notebook presentation.ipynb
